{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "version": "2.0.0.1",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "120",
  "action": {
    "default_title": "__MSG_extActionTitle__",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "alarms"
  ],
  "host_permissions": [],
  "web_accessible_resources": [
    {
      "resources": ["src/popup/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
