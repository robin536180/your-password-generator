{
  "manifest_version": 3,
  "name": "密码生成器 (1Password Clone)",
  "version": "1.0",
  "description": "安全、强大的密码生成器",
  "action": {
    "default_popup": "popup.html",
    "default_title": "生成密码",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "clipboardWrite"
  ]
}
