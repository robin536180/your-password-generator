
; ========== 项目级 npm 配置（优先级高于用户目录 .npmrc） ==========

registry=https://mirrors.cloud.tencent.com/npm/

; 激进重试策略（兜底网络波动）
fetch-retries=20
fetch-retry-mintimeout=8000
fetch-retry-maxtimeout=60000
fetch-timeout=900000

; 减少 postinstall（node-gyp 等）
ignore-scripts=true

; 不做审计/捐助弹窗
audit=false
fund=false
loglevel=http

; 减少并发 socket（直连更稳）
maxsockets=6

; 使用缓存（已下载的包不重复从 registry 取）
prefer-offline=true

; 【重要】如果您需要通过系统代理（Clash等 7890）访问外网，
; 把下面两行注释掉，并把端口改成您的代理端口。
; proxy=http://127.0.0.1:7890
; https-proxy=http://127.0.0.1:7890
